{
  "name": "@zengleiyixiao/dsh-desktop-pet",
  "version": "0.7.0",
  "description": "鲸鱼娘桌面看板娘插件（DeepSeek Harness 客户端插件）：仅浮窗模式——App 内不渲染宠物，GUI 启动自动唤起桌面独立置顶浮窗；立绘随状态切换、台词气泡、系统通知、指令输入框、GLM Coding Plan 额度面板（5h/周窗口用量、剩余积分、重置倒计时）；Alt+Shift+W / 输入框旁 🐳 按钮随时显隐。",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "client-plugin",
    "desktop-pet",
    "whale-girl",
    "kanban-musume",
    "鲸鱼娘",
    "看板娘",
    "glm",
    "coding-plan",
    "quota"
  ],
  "author": "zengleiyixiao1",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./quota": "./lib/quota.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    },
    "manifestVersion": 1
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6 || >=0.2.0-rc.1 <0.3.0-0"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/quota.js",
    "lib/float.html",
    "lib/float-app/",
    "cordis.patch.yml",
    "NOTICE.md",
    "LICENSE",
    "README.md"
  ],
  "license": "MIT"
}
